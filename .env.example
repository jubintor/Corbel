# ==============================================================================
# Corbel — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=Corbel
APP_VERSION=0.1.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
# Default is 5432. If your host workstation already runs local PostgreSQL on 5432, set to 5433.
POSTGRES_PORT=5432
POSTGRES_USER=corbel
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_DB=corbel_db

# Database Connection Pool Settings (P1-LIM-008, P1-LIM-009)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_HEALTH_CHECK_TIMEOUT_SECONDS=3.0

# Security & Authentication Settings (Phase 2)
JWT_SECRET_KEY=change_me_to_a_secure_random_string_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

